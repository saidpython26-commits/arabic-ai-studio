{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 100000 },
        "timestamp": { "type": "number" },
        "fileContext": { "type": "string" }
      },
      "required": ["id", "conversationId", "role", "content", "timestamp"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "An AI-generated image with prompt and options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string", "maxLength": 2000 },
        "enhancedPrompt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "aspectRatio": { "type": "string", "enum": ["1:1", "16:9", "9:16"] },
        "style": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "prompt", "imageUrl", "createdAt"]
    },
    "GeneratedApp": {
      "title": "GeneratedApp",
      "description": "A single-file HTML/JS app generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "html": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "html", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations belonging to the user"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside a user conversation"
    },
    "/users/{userId}/images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "AI images generated by the user"
    },
    "/users/{userId}/apps/{appId}": {
      "schema": "GeneratedApp",
      "description": "Interactive HTML apps generated by the user"
    }
  }
}
